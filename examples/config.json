{
  "enabled": false,
  "includeSummary": false,
  "timeoutMs": 8000,
  "channels": {
    "phone": {
      "type": "bark",
      "server": "https://api.day.app",
      "deviceKey": "env:BARK_DEVICE_KEY",
      "group": "harness"
    },
    "telegram": {
      "type": "telegram",
      "botToken": "env:TELEGRAM_BOT_TOKEN",
      "chatId": "env:TELEGRAM_CHAT_ID"
    },
    "ntfy": {
      "type": "ntfy",
      "server": "https://ntfy.sh",
      "topic": "env:NTFY_TOPIC"
    },
    "feishu": {
      "type": "feishu",
      "cli": "lark-cli",
      "identity": "user",
      "userId": "env:FEISHU_USER_ID"
    }
  },
  "routes": {
    "codex": ["phone"],
    "claude": ["telegram"],
    "dsh": ["feishu"],
    "*": []
  }
}
